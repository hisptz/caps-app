    "scripts": {
        "build": "d2-app-scripts build",
        "bd": "pnpm run build && pnpm run deploy --username admin http://localhost:8080",
        "start": "dotenv -- cross-var d2-app-scripts start --proxy %DHIS2_PROXY_URL%",
        "test": "d2-app-scripts test",
        "deploy": "d2-app-scripts deploy",
        "typecheck": "tsc --noEmit",
        "lint": "eslint && prettier -c .",
        "format": "prettier . -w",
        "e2e": "playwright test",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,mjs,cjs,ts,tsx}": [
            "eslint --max-warnings=0 --fix",
            "prettier --write"
        ],
        "*.{css,json,md,html,yml,yaml}": "prettier --write"
    },
    "dependencies": {
