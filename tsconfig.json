{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": true,
        "jsx": "react",
        "esModuleInterop": true,
        "target": "ESNext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["jest"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "types"]
}
